ENVIRONMENT=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=picgallery

SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["*"]

# --- Email (verification / password reset) ---
# Leave SMTP_HOST blank to disable real sending (token is still stored,
# just not emailed). For Gmail: use smtp.gmail.com, port 587, TLS on,
# and a 16-character Google App Password (not your normal password) —
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Leave SMTP_FROM_EMAIL blank to send from your SMTP_USERNAME address
# (required anyway by providers like Gmail, which override any other
# From address with your actual logged-in account).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PicGallery Support

# The URL your phone/emulator/client can reach this backend at (no
# /api/v1 suffix) — used to build the clickable link inside the
# verification email AND every media file_url/thumbnail_url the API
# returns. Required — the backend raises a clear error if this is unset
# and something tries to use it, rather than silently building a broken
# URL. A LAN IP (found via `ipconfig`/`ifconfig`) only works from the
# same Wi-Fi network, so for anything else (mobile data, a different
# network) use a persistent tunnel instead — e.g.:
#   cloudflared tunnel --url http://localhost:8000
#   ngrok http 8000
# then set this to the https URL it gives you. In production, use your
# real domain instead.
APP_PUBLIC_URL=

# Where the *client app* resolves a shared-gallery link. Usually the
# same tunnel/domain as APP_PUBLIC_URL (defaults to it if left blank —
# see SHARE_LINK_BASE_URL's docstring in core/config.py), but can point
# elsewhere if shared links are served from a different host.
SHARE_LINK_BASE_URL=

# --- Sign in with Google / Apple ---
# List every OAuth client ID your app uses across platforms (Google
# issues a separate one per Android/iOS/Web target); an ID missing from
# this list is rejected as an untrusted audience even if the token
# itself is a valid, unexpired, correctly-signed Google/Apple token.
GOOGLE_CLIENT_IDS=["YOUR-ANDROID-CLIENT-ID.apps.googleusercontent.com","YOUR-IOS-CLIENT-ID.apps.googleusercontent.com"]
APPLE_CLIENT_IDS=["com.yourcompany.picgallery"]
