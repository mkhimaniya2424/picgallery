<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>picgallery</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>picgallery</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Permissions ── -->
	<key>NSCameraUsageDescription</key>
	<string>PicGallery needs access to your camera so you can capture photos and videos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PicGallery needs access to your photo library so you can browse, select, and manage your photos and videos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>This app saves photos and videos to your gallery.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PicGallery needs access to the microphone when recording videos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PicGallery needs access to your location only when required for app features.</string>

	<!-- ── Google Sign-In ──
	     GIDClientID   = the iOS OAuth client ID from GoogleService-Info.plist —
	                     used by the native GID SDK to present the sign-in sheet.
	     GIDServerClientID = the Web OAuth client ID — tells the SDK to mint an
	                     id_token whose `aud` claim equals this ID, so the backend
	                     (verify_google_id_token in social_auth.py) can verify it.
	                     Without this key the id_token comes back null on iOS. -->
	<key>GIDClientID</key>
	<string>198690480208-gsdjbgheu820uc3rs3f9mfqco3ku6pdi.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>198690480208-ubgq186vdo50uf336g6pp9t6213tdndf.apps.googleusercontent.com</string>

	<!-- ── URL Schemes ──
	     1. REVERSED_CLIENT_ID  — required by google_sign_in for the OAuth redirect
	     2. picgallery://       — deep links: payment-success, email-verified, etc. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.198690480208-gsdjbgheu820uc3rs3f9mfqco3ku6pdi</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mk.picgallery</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>picgallery</string>
			</array>
		</dict>
	</array>

	<!-- ── Background Modes ── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- ── App Transport Security ── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>